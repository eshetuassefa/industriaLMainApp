generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id          String   @id @default(uuid())
  firstName   String
  middleName  String?
  lastName    String
  sex         String
  dob         DateTime
  phoneNumber String?
  address     String?
  patient     Patient?
  user        User?
  createdAt   DateTime @default(now())
  updatedAt   DateTime? // Optional to avoid migration issues
}

model Patient {
  id                 String            @id @default(uuid())
  nationalId         String?
  birthCertificate   String?
  bloodType          String?          
  emergencyContact   EmergencyContact? @relation(fields: [emergencyContactId], references: [id])
  emergencyContactId String?           @unique
  person             Person            @relation(fields: [personId], references: [id])
  personId           String            @unique
  medicalRecords     MedicalRecord[]
  testRequests       TestRequest[]
  appointments       Appointment[]
  doctorAssignments  PatientDoctorAssignment[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime?         // Optional
}

model EmergencyContact {
  id        String   @id @default(uuid())
  name      String
  phone     String
  patient   Patient? @relation
  createdAt DateTime @default(now())
  updatedAt DateTime? // Optional
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  password              String
  username              String?           @unique
  role                  RoleType
  person                Person            @relation(fields: [personId], references: [id])
  personId              String            @unique
  department            Department?       @relation(fields: [departmentId], references: [id])
  departmentId          String?           // Optional for HEALTHCARE_PROVIDER
  hospital              Hospital?         @relation(fields: [hospitalId], references: [id])
  hospitalId            String?           // Optional for ADMIN
  createdAt             DateTime          @default(now())
  updatedAt             DateTime?         // Optional
  technicianResults     TestResult[]      @relation("TechnicianResults")
  approvedResults       TestResult[]      @relation("ApprovedResults")
  medicalRecords        MedicalRecord[]   @relation("DoctorMedicalRecords")
  testRequests          TestRequest[]     @relation(fields: [], references: [])
  labResults            LabResult[]       @relation(fields: [], references: [])
  prescriptions         Prescription[]    @relation("PrescribedBy")
  deliveredPrescriptions Prescription[]    @relation("DeliveredByPharmacist")
  radiologyReports      RadiologyReport[] @relation("RadiologistReports")
  orders                Order[]           @relation(fields: [], references: [])
  appointments          Appointment[]
  patientAssignments    PatientDoctorAssignment[]
}

model MedicalRecord {
  id                  String            @id @default(uuid())
  patient             Patient           @relation(fields: [patientId], references: [id])
  patientId           String
  visitDate           DateTime
  diagnosis           String?
  createdAt           DateTime?         @default(now())
  updatedAt           DateTime?         // Already optional
  chiefComplaint      String?
  bloodPressure       String?
  heartRate           Int?
  temperature         Float?
  physicalExamination String?
  doctor              User?             @relation("DoctorMedicalRecords", fields: [doctorId], references: [id])
  doctorId            String?
  notes               String?
  labResults          LabResult[]
  prescriptions       Prescription[]
  radiologyReports    RadiologyReport[]
  orders              Order[]
  radiologyRequests   RadiologyRequest[]
}

model LabResult {
  id              String        @id @default(uuid())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId String
  testName        String
  resultValue     String?
  unit            String?
  referenceRange  String?
  testDate        DateTime
  technician      User?         @relation(fields: [technicianId], references: [id])
  technicianId    String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     // Optional
}

model Drug {
  id           String         @id @default(uuid())
  name         String         @unique
  genericName  String?
  dosageForm   DosageForm
  strength     String
  manufacturer String?
  status       DrugStatus     @default(ACTIVE)
  reorderLevel Int?           @default(10)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  inventory    DrugInventory[]
}

model DrugInventory {
  id              String     @id @default(uuid())
  drug            Drug       @relation(fields: [drugId], references: [id])
  drugId          String
  batchNumber     String
  expirationDate  DateTime
  quantity        Int        @default(0)
  supplier        String?
  purchaseDate    DateTime?
  purchasePrice   Float?
  sellingPrice    Float?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Prescription {
  id              String        @id @default(uuid())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId String
  drugName        String
  dosage          String?
  frequency       String?
  duration        String?
  instructions    String?
  quantity        Int?          @default(1)
  dispensed       Boolean       @default(false)
  prescribedBy    User?         @relation("PrescribedBy", fields: [prescribedById], references: [id])
  prescribedById  String?
  deliveredBy     User?         @relation("DeliveredByPharmacist", fields: [deliveredById], references: [id])
  deliveredById   String?
  deliveredAt     DateTime?
  deliveryStatus  DeliveryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     // Optional
}

model RadiologyRequest {
  id              String        @id @default(uuid())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId String
  imagingType     String
  bodyPart        String?
  notes           String?
  status          TestStatus    @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  report          RadiologyReport?
}

model RadiologyReport {
  id                  String            @id @default(uuid())
  medicalRecord       MedicalRecord     @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId     String
  imagingType         String
  bodyPart            String?
  reportText          String?
  reportDate          DateTime
  radiologist         User?             @relation("RadiologistReports", fields: [radiologistId], references: [id])
  radiologistId       String?
  notes               String?
  radiologyRequest    RadiologyRequest? @relation(fields: [radiologyRequestId], references: [id])
  radiologyRequestId  String?           @unique
  imageUrls           Json?             // Array of image URLs (e.g., ["path/to/image1.jpg", "path/to/image2.jpg"])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime?         // Optional
}

model Order {
  id              String        @id @default(uuid())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId String
  orderType       String
  orderDetails    String
  orderedBy       User?         @relation(fields: [orderedById], references: [id])
  orderedById     String?
  orderDate       DateTime
  status          String        @default("Pending")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Hospital {
  id            String      @id @default(uuid())
  name          String      @unique
  code          String      @unique
  region        Region      @relation(fields: [regionId], references: [id])
  regionId      Int
  city          String
  zone          String
   woreda String
  testRequests  TestRequest[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime?   // Optional
  Department    Department[]
  users         User[]      // Relation to users (admins)
}

model Region {
  id        Int        @id
  name      String     @unique
  hospitals Hospital[]
  createdAt DateTime   @default(now())
  updatedAt DateTime?  // Optional
}

model Department {
  id              String      @id @default(uuid())
  name            String      @unique
  code            String      @unique
  hospital        Hospital?    @relation(fields: [hospitalId], references: [id])
  hospitalId      String?
  users           User[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   // Optional
    testTypes       TestType[]  @relation("DepartmentTestTypes")

}

model TestType {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  specimens    String[]      @db.VarChar(255)
  duration     Int
  requests     TestRequest[]
  department   Department?   @relation("DepartmentTestTypes", fields: [departmentId], references: [id])
  departmentId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     // Optional
}

model TestRequest {
  id          String       @id @default(uuid())
  patient     Patient      @relation(fields: [patientId], references: [id])
  patientId   String
  doctor      User         @relation(fields: [doctorId], references: [id])
  doctorId    String
  testType    TestType     @relation(fields: [testTypeId], references: [id])
  testTypeId  String
  hospital    Hospital     @relation(fields: [hospitalId], references: [id])
  hospitalId  String
  status      TestStatus   @default(REQUESTED)
  notes       String?
  requestedAt DateTime     @default(now())
  results     TestResult[]
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TestResult {
  id           String       @id @default(uuid())
  request      TestRequest  @relation(fields: [requestId], references: [id])
  requestId    String
  technician   User         @relation("TechnicianResults", fields: [technicianId], references: [id])
  technicianId String
  values       Json
  status       ResultStatus @default(PENDING)
  completedAt  DateTime?
  approvedBy   User?        @relation("ApprovedResults", fields: [approvedById], references: [id])
  approvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Appointment {
  id        String            @id @default(uuid())
  patient   Patient           @relation(fields: [patientId], references: [id])
  patientId String
  doctor    User              @relation(fields: [doctorId], references: [id])
  doctorId  String
  date      DateTime
  duration  Int               // Duration in minutes
  type      AppointmentType
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
}

model PatientDoctorAssignment {
  id        String   @id @default(uuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  doctor    User     @relation(fields: [doctorId], references: [id])
  doctorId  String
  assignedAt DateTime @default(now())
  status    AssignmentStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
}

enum RoleType {
  ADMIN
  SUPERADMIN
  RECEPTIONIST
  HEALTHCARE_PROVIDER
  LAB_TECHNICIAN
  RADIOLOGIST
  PHARMACIST
}

enum TestStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING
}

enum ResultStatus {
  PENDING
  COMPLETED
  APPROVED
  REJECTED
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  ROUTINE_CHECK
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum DosageForm {
  TABLET
  CAPSULE
  LIQUID
  INJECTION
  TOPICAL
  SUPPOSITORY
  POWDER
  OTHER
}

enum DrugStatus {
  ACTIVE
  DISCONTINUED
  OUT_OF_STOCK
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}